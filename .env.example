# bSafety API. Copy to .env.local for `pnpm dev`. Placeholders only: never commit real values.
NODE_ENV=development
PORT=8790
HOST=127.0.0.1
DATA_DIR=./data

# 32+ random characters each. Required in production.
SESSION_SECRET=your-session-secret-here
IP_HASH_SALT=your-ip-hash-salt-here

# The review page's own origin(s). Required in production, e.g. https://safety.example.com
REVIEW_ORIGINS=

# Identity keys (66 hex, comma-separated) of the named human reviewers.
REVIEWER_KEYS=

# One token (32+ chars) per marketplace server: bphotosx:<token>,bdrivex:<token>,bmarketx:<token>
SERVICE_TOKENS=

# Set to 1 only behind a proxy you control (Caddy/nginx) that sets X-Forwarded-For.
TRUST_PROXY=0

# Alerts: POST { caseId, category, dueBy, service, at } here for serious cases. Optional HMAC signature header.
WEBHOOK_URL=
WEBHOOK_SECRET=

# Production reviewer references: signed, 10-minute URLs the marketplace verifies before serving a preview.
REF_SIGNING_SECRET=
# Fallback reference per service when an item has none: bphotosx=https://bphotosx.com/review-preview/{id}
REVIEW_REF_TEMPLATES=

# Report limits (per salted IP hash, and per item, per hour).
REPORT_LIMIT_IP_PER_HOUR=10
REPORT_LIMIT_ITEM_PER_HOUR=20

# Perceptual (dHash) match threshold in bits out of 64.
DHASH_MAX_DISTANCE=10
SCREEN_MAX_BYTES=41943040

# Phase 2 (not used yet: the providers are stubs and stay "not configured" even if these are set).
PHOTODNA_KEY=
PHOTODNA_ENDPOINT=
CLASSIFIER_KEY=
CLASSIFIER_ENDPOINT=
